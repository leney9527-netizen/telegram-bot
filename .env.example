# 从 @BotFather 获取的 Bot Token（必填）
BOT_TOKEN=your_bot_token_here

# 运行模式：polling（默认，适合本机/VPS）或 webhook
BOT_MODE=polling

# webhook 模式才需要填写
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_PORT=3000

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 业务表格放在 data/，命名：YYYY-MM-DD发货快递单.csv（或 .xls / .xlsx）
# 机器人会在北京时间每天下午 16:00、18:00、20:00、22:00 核对当天表格是否已更新并转为 JSON
